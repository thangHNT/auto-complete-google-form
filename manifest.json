{
  "manifest_version": 3,
  "name": "Auto fill google form",
  "version": "0.2.2",
  "description": "Quét, tạo mẫu câu trả lời và tự động điền Google Forms.",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://docs.google.com/forms/*",
    "https://forms.gle/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Auto fill google form",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
